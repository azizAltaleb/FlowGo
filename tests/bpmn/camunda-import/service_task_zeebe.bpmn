<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:artificialflow="http://artificialflow.io/schema/1.0/bpmn"
                  id="Definitions_camunda_import"
                  targetNamespace="https://artificialflow.io/camunda-import">
  <bpmn:process id="camunda_import_rewrite" isExecutable="true">
    <bpmn:startEvent id="start" name="Start"/>
    <!-- Original Camunda shape (lint: rewrite). Remodeled ArtificialFlow attribute below. -->
    <bpmn:serviceTask id="validate" name="Validate" artificialflow:taskType="golden-validate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="camunda-validate"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="review" name="Review" artificialflow:assignee="reviewer" artificialflow:candidateGroups="approvers"/>
    <bpmn:endEvent id="end" name="End"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="validate"/>
    <bpmn:sequenceFlow id="f2" sourceRef="validate" targetRef="review"/>
    <bpmn:sequenceFlow id="f3" sourceRef="review" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>
